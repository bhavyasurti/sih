# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend
APP_NAME=NetSecure AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
# Database (Local SQLite default, or external PostgreSQL for production)
# Local SQLite: sqlite:///./data/netsecure.db
# Vercel Temporary SQLite: sqlite:////tmp/netsecure.db (or leave empty to default automatically)
# Production PostgreSQL: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=sqlite:///./data/netsecure.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=

